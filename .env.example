# =============================================================================
# LDP Legal Suite — variables de entorno
# Copia este archivo a `.env` y reemplaza valores antes de levantar la app.
# =============================================================================

# ----- Postgres -------------------------------------------------------------
# Runtime: rol app_user con BYPASSRLS = false. RLS aplica a todas las queries.
DATABASE_URL=postgres://app_user:CHANGE_ME_APP_PASSWORD@localhost:5432/ldp_legal_suite

# Migraciones, seeds y operaciones administrativas: usa el owner del schema
# (puede ser el superuser `postgres`). NUNCA se usa en runtime de la app.
DATABASE_MIGRATE_URL=postgres://postgres:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/ldp_legal_suite

# ----- Auth (better-auth) ---------------------------------------------------
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_SECRET
BETTER_AUTH_URL=http://localhost:3000

# ----- Defaults -------------------------------------------------------------
DEFAULT_FIRM_TIMEZONE=America/Santo_Domingo
DEFAULT_FIRM_CURRENCY=DOP

# ----- Storage (Fase 2 + Fase 6) --------------------------------------------
# Driver: 'local' (dev, escribe a STORAGE_ROOT) o 's3' (producción, cualquier
# bucket S3-compatible: AWS S3, Cloudflare R2, Backblaze B2).
STORAGE_DRIVER=local
STORAGE_ROOT=./storage

# Si STORAGE_DRIVER=s3, configurar lo siguiente. Ejemplo Cloudflare R2:
# S3_BUCKET=ldp-legal-suite
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...

# ----- Email (Fase 6) — opcional --------------------------------------------
# Driver: 'console' (default, loguea a stdout) o 'resend'.
# Si EMAIL_DRIVER=resend, configurar RESEND_API_KEY y EMAIL_FROM (email
# remitente verificado en la cuenta Resend).
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM=

# ----- AI / Claude (Fase 5) — opcional --------------------------------------
# Si esta variable está set, la app expone la capa de IA: resumen de casos,
# redacción asistida en notas, búsqueda semántica en /documentos. Sin la
# clave, los botones "IA" muestran un mensaje pidiendo configurarla y el
# resto de la app funciona normal.
# Generar API key en https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Modelo por default. claude-sonnet-4-6 da el mejor balance calidad/coste
# para tareas legales. Para tareas más rápidas y baratas, usar haiku.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ----- Scan ingest worker (Fase 6) — opcional -------------------------------
# Bearer token compartido entre el worker externo de escaneos (HP/Canon) y
# /api/scan-ingest. Si esta variable NO está set, ambos endpoints rechazan
# todos los requests con 401. Generar con: openssl rand -base64 32 (mínimo
# 32 bytes recomendado).
SCAN_WORKER_API_KEY=

# ----- Node -----------------------------------------------------------------
NODE_ENV=development
