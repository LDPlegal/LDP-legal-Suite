# =============================================================================
# LDP Legal Suite — variables de entorno
# Copia este archivo a `.env` y reemplaza valores antes de levantar la app.
# =============================================================================

# ----- Postgres -------------------------------------------------------------
# Runtime: rol app_user con BYPASSRLS = false. RLS aplica a todas las queries.
DATABASE_URL=postgres://app_user:CHANGE_ME_APP_PASSWORD@localhost:5432/ldp_legal_suite

# Migraciones, seeds y operaciones administrativas: usa el owner del schema
# (puede ser el superuser `postgres`). NUNCA se usa en runtime de la app.
DATABASE_MIGRATE_URL=postgres://postgres:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/ldp_legal_suite

# ----- Auth (better-auth) ---------------------------------------------------
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_SECRET
BETTER_AUTH_URL=http://localhost:3000

# ----- Defaults -------------------------------------------------------------
DEFAULT_FIRM_TIMEZONE=America/Santo_Domingo
DEFAULT_FIRM_CURRENCY=DOP

# ----- Storage (Fase 2) -----------------------------------------------------
# `local` writes to STORAGE_ROOT on the host filesystem (dev default).
# `s3` (not implemented in Fase 2) would use S3-compatible env vars.
STORAGE_DRIVER=local
STORAGE_ROOT=./storage

# ----- AI / Claude (Fase 5) — opcional --------------------------------------
# Si esta variable está set, la app expone la capa de IA: resumen de casos,
# redacción asistida en notas, búsqueda semántica en /documentos. Sin la
# clave, los botones "IA" muestran un mensaje pidiendo configurarla y el
# resto de la app funciona normal.
# Generar API key en https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Modelo por default. claude-sonnet-4-6 da el mejor balance calidad/coste
# para tareas legales. Para tareas más rápidas y baratas, usar haiku.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ----- Node -----------------------------------------------------------------
NODE_ENV=development
